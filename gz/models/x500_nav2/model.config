<?xml version="1.0"?>
<model>
  <name>x500_nav2</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    x500 加上前視相機、下視相機與 2D 光達。
    PX4 內建的 x500_mono_cam / x500_mono_cam_down / x500_lidar_2d 每台只有一種
    感測器，這台把三者合在一起，飛行物理完全沿用 x500（機型仍是 4001_gz_x500）。
  </description>
</model>
